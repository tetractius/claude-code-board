{
  "name": "claude-code-board",
  "version": "0.1.0",
  "description": "A board for monitoring, annotating and resuming Claude Code sessions",
  "main": "./out/main/index.js",
  "author": "fil",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && node scripts/brand-dev.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never && cp scripts/install-macos.sh release/",
    "dist:linux": "scripts/dist-linux.sh",
    "smoke": "node scripts/smoke.ts",
    "icon": "electron scripts/make-icon.mjs",
    "brand:dev": "node scripts/brand-dev.mjs",
    "dist:mac:all": "npm run build && electron-builder --mac --arm64 --x64 --publish never && cp scripts/install-macos.sh release/"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "build": {
    "appId": "dev.fil.claude-code-board",
    "productName": "Claude Code Board",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "Claude-Code-Board-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "Monitor, annotate and resume Claude Code sessions",
      "description": "A board for every Claude Code session on the machine - live, background and finished - with per-session notes and copy-ready resume and delete commands.",
      "maintainer": "fil <filippo.trimoldi@hiveautonomy.com>",
      "artifactName": "Claude-Code-Board-${version}-linux-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "dmg": {
      "title": "Claude Code Board"
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
